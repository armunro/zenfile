<Window x:Class="Zenfile.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Zenfile.ViewModels"
        xmlns:models="clr-namespace:Zenfile.Models"
        Title="Zenfile - Work File Organizer"
        Width="1020" Height="680"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar / Title -->
            <RowDefinition Height="54"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30"
                            Background="{StaticResource AccentBlueBrush}"
                            CornerRadius="8"
                            Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Zenfile"
                               FontWeight="Bold"
                               FontSize="17"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Work File Organizer"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="8,2,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton Content="📁 Work Roots &amp; Tasks"
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Null}, Mode=OneWay}"
                                 x:Name="TabRoots"
                                 Click="OnTabRootsClicked"
                                 Style="{StaticResource PillRadioButton}"
                                 Margin="0,0,8,0"/>
                    <RadioButton Content="🎯 Drop Zone"
                                 x:Name="TabDrop"
                                 Click="OnTabDropClicked"
                                 Style="{StaticResource PillRadioButton}"
                                 Margin="0,0,8,0"/>
                    <RadioButton Content="⚙️ Explorer Integration"
                                 x:Name="TabShell"
                                 Click="OnTabShellClicked"
                                 Style="{StaticResource PillRadioButton}"
                                 Margin="0,0,8,0"/>
                    <RadioButton Content="📜 History"
                                 x:Name="TabHistory"
                                 Click="OnTabHistoryClicked"
                                 Style="{StaticResource PillRadioButton}"/>
                </StackPanel>

                <!-- Context Menu Status Pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgInputBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsContextMenuRegistered}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding IsContextMenuRegistered, StringFormat='{}Explorer Menu: {0}'}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Content="↻ Refresh"
                            Command="{Binding RefreshAllCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,5"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content (Tab Switcher) -->
        <Grid Grid.Row="1">
            <!-- TAB 1: Work Roots & Tasks -->
            <Grid Visibility="{Binding SelectedTabIndex, Converter={x:Null}, ConverterParameter=0}">
                <Grid.ColumnDefinitions>
                    <!-- Left: Work Roots List -->
                    <ColumnDefinition Width="280" MinWidth="220" MaxWidth="400"/>
                    <!-- Splitter -->
                    <ColumnDefinition Width="1"/>
                    <!-- Right: Task / Project Folders -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Work Roots Panel -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgCardBrush}"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="WORK ROOTS"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="+ Add Root"
                                    Command="{Binding AddRootCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="8,4"
                                    FontSize="11"/>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding WorkRoots}"
                                 SelectedItem="{Binding SelectedRoot}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:WorkRoot}">
                                    <Border Margin="0,3"
                                            Padding="10,8"
                                            CornerRadius="6"
                                            Background="{StaticResource BgInputBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    Background="{StaticResource AccentBlueBrush}"
                                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Root Action Buttons -->
                        <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Open Folder"
                                    Command="{Binding OpenRootInExplorerCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="11"
                                    Padding="8,4"
                                    Margin="0,0,6,0"/>
                            <Button Content="Remove"
                                    Command="{Binding RemoveRootCommand}"
                                    Style="{StaticResource DangerButton}"
                                    FontSize="11"
                                    Padding="8,4"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Divider -->
                <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

                <!-- Task / Project Folders Panel -->
                <Grid Grid.Column="2" Margin="18,14">
                    <Grid.RowDefinitions>
                        <!-- Top filter & new folder -->
                        <RowDefinition Height="Auto"/>
                        <!-- Folder cards list -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar for Tasks -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,6"
                                 FontSize="13"
                                 Width="280"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,10,0"/>

                        <!-- New Task Creator -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     Width="180"
                                     Margin="0,0,6,0"
                                     KeyDown="OnNewTaskKeyDown"
                                     x:Name="NewTaskInput"/>
                            <Button Content="+ Create Folder"
                                    Command="{Binding CreateTaskCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="10,6"
                                    FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <!-- Task Cards ItemsControl / ListBox -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <ListBox ItemsSource="{Binding FilteredTaskFolders}"
                                 SelectedItem="{Binding SelectedTask}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True"
                                 Drop="OnTaskListDrop"
                                 DragOver="OnTaskListDragOver">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:WorkTaskFolder}">
                                    <Border Width="220"
                                            Margin="6"
                                            Padding="12"
                                            CornerRadius="8"
                                            Background="{StaticResource BgInputBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            AllowDrop="True"
                                            Drop="OnTaskCardDrop"
                                            DragOver="OnTaskCardDragOver">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Folder Header -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32"
                                                        Background="{StaticResource BgHoverBrush}"
                                                        CornerRadius="6"
                                                        Margin="0,0,8,0">
                                                    <TextBlock Text="📂" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding WorkRootName}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource AccentBlueBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- File Count & Modified -->
                                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding FileCount, StringFormat='{}{0} file(s) inside'}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding LastModified, StringFormat='{}Modified: {0:yyyy-MM-dd HH:mm}'}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>

                                            <!-- Card Actions -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Content="Open in Explorer"
                                                        Click="OnOpenCardInExplorerClicked"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        FontSize="11"
                                                        Padding="6,3"
                                                        Margin="0,0,4,0"/>

                                                <Button Grid.Column="1"
                                                        Content="🗑"
                                                        Click="OnDeleteCardClicked"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource DangerButton}"
                                                        FontSize="11"
                                                        Padding="6,3"
                                                        ToolTip="Delete this folder"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <!-- TAB 2: Drag & Drop Zone -->
            <Grid x:Name="TabDropPanel" Visibility="Collapsed" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Drag and drop any files or folders below to move or copy them into a selected project folder."
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,16"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Big Drop Target Area -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource AccentBlueBrush}"
                            BorderThickness="2"
                            CornerRadius="12"
                            Margin="0,0,16,0"
                            AllowDrop="True"
                            Drop="OnBigDropAreaDrop"
                            DragOver="OnBigDropAreaDragOver"
                            x:Name="BigDropArea">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📥" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Drag &amp; Drop Files or Folders Here"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="Files will be transferred directly to the selected destination folder"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Transfer Settings Sidecard -->
                    <Border Grid.Column="1"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="Target Folder:"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>

                            <ComboBox ItemsSource="{Binding TaskFolders}"
                                      SelectedItem="{Binding SelectedTask}"
                                      DisplayMemberPath="Name"
                                      Padding="10,8"
                                      Background="{StaticResource BgInputBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,0,16"/>

                            <TextBlock Text="Transfer Action:"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,6"/>
                            <ComboBox SelectedValue="{Binding SelectedMode}"
                                      SelectedValuePath="Tag"
                                      Padding="10,8"
                                      Background="{StaticResource BgInputBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,16,0">
                                <ComboBoxItem Content="Move Files (Default)" Tag="{x:Static models:TransferMode.Move}"/>
                                <ComboBoxItem Content="Copy Files" Tag="{x:Static models:TransferMode.Copy}"/>
                            </ComboBox>

                            <TextBlock Text="Conflict Resolution:"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,14,0,6"/>
                            <ComboBox SelectedValue="{Binding SelectedConflictResolution}"
                                      SelectedValuePath="Tag"
                                      Padding="10,8"
                                      Background="{StaticResource BgInputBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,16,0">
                                <ComboBoxItem Content="Auto-Rename (keep both)" Tag="{x:Static models:ConflictResolution.AutoRename}"/>
                                <ComboBoxItem Content="Overwrite" Tag="{x:Static models:ConflictResolution.Overwrite}"/>
                                <ComboBoxItem Content="Skip" Tag="{x:Static models:ConflictResolution.Skip}"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- TAB 3: Explorer Integration -->
            <Grid x:Name="TabShellPanel" Visibility="Collapsed" Margin="24">
                <Border Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24"
                        MaxWidth="720"
                        HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Windows Explorer Right-Click Context Menu"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Integrates Zenfile directly into Windows Explorer so you can right-click any files or folders and send them straight to your predefined project folders or open the quick popup destination picker."
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>

                        <!-- Settings Options -->
                        <CheckBox Content="Create cascading submenus for all project folders in Explorer menu"
                                  IsChecked="{Binding RegisterCascadingSubmenus}"
                                  Margin="0,0,0,10"/>

                        <CheckBox Content="Include 'Choose Destination Popup...' launcher verb"
                                  IsChecked="{Binding RegisterPopupVerb}"
                                  Margin="0,0,0,10"/>

                        <CheckBox Content="Enable context menu for folders as well as files"
                                  IsChecked="{Binding IncludeDirectoriesInContextMenu}"
                                  Margin="0,0,0,24"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Sync / Register Context Menu"
                                    Command="{Binding SyncContextMenuCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,10"
                                    Margin="0,0,12,0"/>

                            <Button Content="Remove Context Menu"
                                    Command="{Binding UnregisterContextMenuCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Padding="16,10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TAB 4: History -->
            <Grid x:Name="TabHistoryPanel" Visibility="Collapsed" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Recent File Transfers"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Clear History"
                            Command="{Binding ClearHistoryCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,5"
                            FontSize="12"/>
                </Grid>

                <Border Grid.Row="1"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <ListBox ItemsSource="{Binding TransferHistory}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TransferItem}">
                                <Border Margin="4,3"
                                        Padding="10,8"
                                        CornerRadius="6"
                                        Background="{StaticResource BgInputBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Icon -->
                                        <TextBlock Text="{Binding Success, Converter={x:Null}}"
                                                   FontSize="16"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceFileName}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding DestinationPath, StringFormat='{}→ {0}'}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FormattedTimestamp}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Open Destination"
                                                Click="OnOpenHistoryFolderClicked"
                                                Tag="{Binding}"
                                                Style="{StaticResource SecondaryButton}"
                                                FontSize="11"
                                                Padding="8,4"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding TaskFolders.Count, StringFormat='{}{0} task folder(s)'}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
